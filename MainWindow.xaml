<Window x:Class="MusicWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicWidget"
        mc:Ignorable="d"
        Title="CornerGroove"
        Icon="logo.png"
        Height="364" Width="388"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Flat Soft Round Button (Prev/Next/Controls) -->
        <Style x:Key="FlatRoundBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple-Style High-Contrast Play/Pause Button -->
        <Style x:Key="ApplePlayBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayBtnNormalBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PlayBtnHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Header Icon Button Style -->
        <Style x:Key="HeaderIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Width="22" Height="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Chip Button Style -->
        <Style x:Key="ThemeChipBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8,5,8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Open Last Played" Flat Action Button Style -->
        <Style x:Key="OpenLastPlayedBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="8,4,8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3-Bar Sound Wave Animation -->
        <Storyboard x:Key="WaveStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar1"
                             Storyboard.TargetProperty="Height"
                             From="3" To="12" Duration="0:0:0.42"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WaveBar2"
                             Storyboard.TargetProperty="Height"
                             From="4" To="14" Duration="0:0:0.32"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="WaveBar3"
                             Storyboard.TargetProperty="Height"
                             From="3" To="10" Duration="0:0:0.50"
                             AutoReverse="True" />
        </Storyboard>

        <!-- Vinyl Spinning Rotation Animation -->
        <Storyboard x:Key="VinylStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="VinylRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3.6" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Panels Container (Offset 10px from right edge for handle) -->
        <Grid Margin="0,0,10,0" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <!-- Upper Panel: Multi-view (Volume Mixer OR Settings) -->
                <RowDefinition Height="Auto" />
                <!-- Lower Panel: Music Widget (Height="124") -->
                <RowDefinition Height="124" />
            </Grid.RowDefinitions>

            <!-- ==================== UPPER PANEL: MIXER OR SETTINGS ==================== -->
            <!-- Self-contained rounded card: ZERO black bounding box floating on desktop! -->
            <Border x:Name="VolumePopupCard"
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    MaxHeight="228"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Opacity="0"
                    IsHitTestVisible="False"
                    MouseEnter="VolumePopupCard_MouseEnter"
                    MouseLeave="VolumePopupCard_MouseLeave">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="VolumePopupTransform" Y="10"/>
                </Border.RenderTransform>

                <Grid Margin="12,10,12,10">
                    <!-- VIEW 1: VOLUME MIXER VIEW -->
                    <Grid x:Name="ViewMixer" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <!-- Master Volume Header & Slider -->
                            <RowDefinition Height="Auto" />
                            <!-- Subtle Divider -->
                            <RowDefinition Height="12" />
                            <!-- Mixer Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Per-App Sliders Scrollable List -->
                            <RowDefinition Height="*" MaxHeight="130" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Master Volume Control -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="MASTER VOLUME"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtMasterVolumePercent"
                                           Text="70%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Master Mute Button -->
                                <Button x:Name="BtnMasterMute"
                                        Grid.Column="0"
                                        Style="{StaticResource HeaderIconBtnStyle}"
                                        ToolTip="Mute / Unmute Master"
                                        Click="BtnMasterMute_Click">
                                    <Path x:Name="IconMasterSpeaker"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
                                </Button>

                                <!-- Master Volume Interactive Slider -->
                                <Slider x:Name="MasterSlider"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Minimum="0" Maximum="1"
                                        SmallChange="0.01" LargeChange="0.05"
                                        Style="{StaticResource ModernSliderStyle}"
                                        ValueChanged="MasterSlider_ValueChanged" />
                            </Grid>
                        </Grid>

                        <!-- Row 1: Divider -->
                        <Border Grid.Row="1"
                                Height="1"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" />

                        <!-- Row 2: Mixer Header -->
                        <Grid Grid.Row="2" Margin="0,0,0,4">
                            <TextBlock Text="APP VOLUME MIXER"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtAppCount"
                                       Text="Active Sessions"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 3: Per-App Volume Sliders List -->
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="TxtNoAudioApps"
                                           Text="No active app audio streams"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,10,0,10"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed" />

                                <ItemsControl x:Name="AppMixerItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="28" Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon -->
                                                <Image Grid.Column="0"
                                                       Source="{Binding Icon}"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <!-- App Name -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AppName}"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,4,0"
                                                           ToolTip="{Binding AppName}"/>

                                                <!-- App Mute Toggle -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource HeaderIconBtnStyle}"
                                                        ToolTip="Mute App"
                                                        Click="AppMuteBtn_Click"
                                                        Tag="{Binding}">
                                                    <Path Width="9" Height="9"
                                                          Stretch="Uniform"
                                                          Fill="{DynamicResource TextSecondaryBrush}"
                                                          Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
                                                </Button>

                                                <!-- App Volume Interactive Slider -->
                                                <Slider Grid.Column="3"
                                                        Margin="4,0,4,0"
                                                        Minimum="0" Maximum="1"
                                                        SmallChange="0.01" LargeChange="0.05"
                                                        Value="{Binding Volume, Mode=TwoWay}"
                                                        Style="{StaticResource ModernSliderStyle}" />

                                                <!-- App Volume Percentage -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding FormattedPercent}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 2: SETTINGS & THEMES VIEW -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Settings Header with Back/Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="10" Height="10"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}"
                                      Margin="0,0,6,0"
                                      Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                <TextBlock Text="Settings &amp; Themes"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Style="{StaticResource HeaderIconBtnStyle}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Close Settings"
                                    Click="BtnCloseSettings_Click">
                                <Path Width="8.5" Height="8.5"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Button>
                        </Grid>

                        <!-- Settings Scrollable Content -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Themes Section -->
                                <TextBlock Text="THEME PALETTE"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,5"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnThemeDark" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnThemeDark_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0"/>
                                            <TextBlock Text="Dark" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnThemeLight" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnThemeLight_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#0D9488" Margin="0,0,5,0"/>
                                            <TextBlock Text="Light" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnThemeDracula" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnThemeDracula_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#BD93F9" Margin="0,0,5,0"/>
                                            <TextBlock Text="Dracula" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnThemeCappuccino" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnThemeCappuccino_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#D4A373" Margin="0,0,5,0"/>
                                            <TextBlock Text="Cappuccino" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Behavior Switches Section -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>

                                <TextBlock Text="BEHAVIOR"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4"/>

                                <!-- Toggle Switch 1: Always on Top -->
                                <CheckBox x:Name="ChkAlwaysOnTop"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="Always on top (Pinned)"
                                          Click="ChkAlwaysOnTop_Click"/>

                                <!-- Toggle Switch 2: Start with Windows -->
                                <CheckBox x:Name="ChkStartWithWindows"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="Start with Windows"
                                          Click="ChkStartWithWindows_Click"/>

                                <!-- In-Game Overlay Hotkey Section -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>

                                <TextBlock Text="TOGGLE HOTKEY (IN-GAME OVERLAY)"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="Brings widget and cursor to top during fullscreen games"
                                           FontSize="8"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,6"/>

                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="BtnHotkeyF8" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnHotkey_Click" Tag="F8">
                                        <TextBlock Text="F8 (Default)" FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnHotkeyF9" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnHotkey_Click" Tag="F9">
                                        <TextBlock Text="F9" FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnHotkeyF10" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnHotkey_Click" Tag="F10">
                                        <TextBlock Text="F10" FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnHotkeyCtrlShiftM" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnHotkey_Click" Tag="Ctrl+Shift+M">
                                        <TextBlock Text="Ctrl+Shift+M" FontSize="9.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button x:Name="BtnHotkeyNone" Style="{StaticResource ThemeChipBtnStyle}" Click="BtnHotkey_Click" Tag="None">
                                        <TextBlock Text="Off" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== LOWER PANEL: MUSIC WIDGET ==================== -->
            <Border x:Name="MainMusicCard"
                    Grid.Row="1"
                    Height="124"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">

                <Grid>
                    <!-- RADIAL BLURRED ABSTRACT GRADIENT AURA (From the left edge behind the vinyl) -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="190" IsHitTestVisible="False" ClipToBounds="True">
                        <!-- Primary Aura Orb -->
                        <Ellipse x:Name="AuraGlow1" Width="140" Height="140"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="-45,0,0,0" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop x:Name="AuraStop1" Color="{DynamicResource AuraColor1}" Offset="0.0" />
                                    <GradientStop x:Name="AuraStop2" Color="{DynamicResource AuraColor2}" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <BlurEffect Radius="42" RenderingBias="Quality" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Secondary Accent Orb -->
                        <Ellipse x:Name="AuraGlow2" Width="95" Height="95"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="-15,0,0,-25" Opacity="0.40">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop x:Name="AuraStop3" Color="{DynamicResource AuraColor3}" Offset="0.0" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <BlurEffect Radius="34" RenderingBias="Quality" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <!-- Main Widget Card Content -->
                    <Grid Margin="12,8,12,8">
                        <Grid.RowDefinitions>
                            <!-- Header (Source badge, Wave, Volume, Settings, Pin, Close) -->
                            <RowDefinition Height="22" />
                            <!-- Content (Vinyl Case & Disc, Details, Controls) -->
                            <RowDefinition Height="*" />
                            <!-- Timeline / Progress -->
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Source App & Wave Visualizer (Clean minimal typography, no badge box) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSourceApp"
                                           Text="Spotify"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />

                                <!-- 3-Bar Audio Wave Animation -->
                                <StackPanel x:Name="WaveContainer"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Height="12"
                                            Margin="8,0,0,0"
                                            Opacity="0.4"
                                            ToolTip="Audio playback visualizer">
                                    <Border x:Name="WaveBar1" Width="2" Height="3"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="1"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,2,0" />
                                    <Border x:Name="WaveBar2" Width="2" Height="5"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="1"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,2,0" />
                                    <Border x:Name="WaveBar3" Width="2" Height="3"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="1"
                                            VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Actions (Mixer, Settings, Pin, Close) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Volume Mixer Button (Hover or Click to open Upper Panel) -->
                                <Button x:Name="BtnVolume"
                                        Style="{StaticResource HeaderIconBtnStyle}"
                                        ToolTip="Volume Mixer &amp; Apps"
                                        Margin="0,0,4,0"
                                        MouseEnter="BtnVolume_MouseEnter"
                                        MouseLeave="BtnVolume_MouseLeave"
                                        Click="BtnVolume_Click">
                                    <Path x:Name="IconHeaderVolume"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                </Button>

                                <!-- Settings / Configure Button -->
                                <Button x:Name="BtnSettings"
                                        Style="{StaticResource HeaderIconBtnStyle}"
                                        ToolTip="Configure Settings &amp; Themes"
                                        Margin="0,0,4,0"
                                        Click="BtnSettings_Click">
                                    <Path Width="10.5" Height="10.5"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                </Button>

                                <!-- Pin Button -->
                                <Button x:Name="BtnPin"
                                        Style="{StaticResource HeaderIconBtnStyle}"
                                        ToolTip="Pin Widget (Always on Top)"
                                        Margin="0,0,4,0"
                                        Click="BtnPin_Click">
                                    <Path x:Name="IconPin"
                                          Width="10.5" Height="10.5"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Data="M16 9V4l1 0c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1l1 0v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z" />
                                </Button>

                                <!-- Close / Dismiss Button -->
                                <Button x:Name="BtnClose"
                                        Style="{StaticResource HeaderIconBtnStyle}"
                                        ToolTip="Hide Widget"
                                        Click="BtnClose_Click">
                                    <Path Width="8.5" Height="8.5"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Content (Vinyl Sleeve & Half Spinning Disc + Details + Controls) -->
                        <Grid Grid.Row="1" Margin="0,3,0,3">
                            <Grid.ColumnDefinitions>
                                <!-- Vinyl Record & Sleeve Assembly -->
                                <ColumnDefinition Width="80" />
                                <!-- Title & Artist & Open Last Played Button -->
                                <ColumnDefinition Width="*" />
                                <!-- Playback Controls -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Vinyl Case & Half Spinning Record Assembly -->
                            <Grid Grid.Column="0"
                                  Width="78" Height="52"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">

                                <!-- Spinning Vinyl Disc (Half sticks out to the right) -->
                                <Grid x:Name="VinylDisc"
                                      Width="48" Height="48"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="26,0,0,0">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="VinylRotation" CenterX="24" CenterY="24" Angle="0"/>
                                    </Grid.RenderTransform>

                                    <!-- Vinyl Dark Body -->
                                    <Ellipse Fill="#111113" Stroke="#202024" StrokeThickness="1"/>

                                    <!-- Concentric Vinyl Grooves -->
                                    <Ellipse Width="40" Height="40" Stroke="#18181C" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="32" Height="32" Stroke="#202025" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="24" Height="24" Stroke="#18181C" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Center Label -->
                                    <Ellipse Width="15" Height="15" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Spindle Hole -->
                                    <Ellipse Width="4.5" Height="4.5" Fill="#111113" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Vinyl Jacket / Sleeve (Front Cover) -->
                                <Border x:Name="VinylSleeve"
                                        Width="50" Height="50"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Placeholder Music Icon -->
                                        <Path x:Name="PlaceholderIcon"
                                              Width="18" Height="18"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource TextMutedBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />

                                        <!-- Song Thumbnail Artwork -->
                                        <Image x:Name="ImgThumbnail"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Song Info (Title & Artist OR Open Last Played button) -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="6,0,6,0">
                                <TextBlock x:Name="TxtTitle"
                                           Text="No Media Playing"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                <TextBlock x:Name="TxtArtist"
                                           Text="Ready to listen"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                <!-- "Open Last Played" Button (Visible when idle) -->
                                <Button x:Name="BtnOpenLastPlayed"
                                        Style="{StaticResource OpenLastPlayedBtnStyle}"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"
                                        Click="BtnOpenLastPlayed_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="9" Height="9"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                                        <TextBlock x:Name="TxtOpenLastPlayed"
                                                   Text="Open Spotify"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Playback Controls -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <!-- Previous Track Button -->
                                <Button x:Name="BtnPrev"
                                        Width="28" Height="28"
                                        Margin="0,0,5,0"
                                        Style="{StaticResource FlatRoundBtnStyle}"
                                        ToolTip="Previous Track"
                                        Click="BtnPrev_Click">
                                    <Path Width="9" Height="9"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextPrimaryBrush}"
                                          Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                                </Button>

                                <!-- Play / Pause Button -->
                                <Button x:Name="BtnPlayPause"
                                        Width="32" Height="32"
                                        Margin="0,0,5,0"
                                        Style="{StaticResource ApplePlayBtnStyle}"
                                        ToolTip="Play / Pause"
                                        Click="BtnPlayPause_Click">
                                    <Path x:Name="IconPlayPause"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource PlayBtnIconBrush}"
                                          Data="M8 5v14l11-7z" />
                                </Button>

                                <!-- Next Track Button -->
                                <Button x:Name="BtnNext"
                                        Width="28" Height="28"
                                        Style="{StaticResource FlatRoundBtnStyle}"
                                        ToolTip="Next Track"
                                        Click="BtnNext_Click">
                                    <Path Width="9" Height="9"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextPrimaryBrush}"
                                          Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Timeline / Progress Bar -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <!-- Elapsed Time -->
                            <TextBlock x:Name="TxtCurrentTime"
                                       Grid.Column="0"
                                       Text="00:00"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />

                            <!-- Interactive Progress Timeline Slider -->
                            <Slider x:Name="TimelineSlider"
                                    Grid.Column="1"
                                    Margin="4,0,4,0"
                                    Minimum="0" Maximum="100"
                                    Style="{StaticResource ModernTimelineSliderStyle}"
                                    PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                    PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                    ValueChanged="TimelineSlider_ValueChanged" />

                            <!-- Total Duration -->
                            <TextBlock x:Name="TxtDuration"
                                       Grid.Column="2"
                                       Text="00:00"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Edge Grip / Pill Handle (Visible at the screen edge when collapsed) -->
        <Border x:Name="EdgeHandle"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,1,44"
                Width="4" Height="36"
                Background="{DynamicResource EdgeHandleBrush}"
                CornerRadius="2"
                Cursor="Hand"
                Opacity="0.8"
                MouseEnter="EdgeHandle_MouseEnter" />
    </Grid>
</Window>
